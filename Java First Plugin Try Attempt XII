package qqqq.untitled;

import org.bukkit.ChatColor;
import org.bukkit.entity.Player;
import org.bukkit.event.EventHandler;
import org.bukkit.event.Listener;
import org.bukkit.event.player.PlayerJoinEvent;

public class GirisDinleyici implements Listener {
    @EventHandler
    public void onPlayerJoin(PlayerJoinEvent event) {
        Player oyuncu = event.getPlayer();

        event.setJoinMessage(ChatColor.DARK_BLUE + oyuncu.getName() + " sunucuya katıldı!");
        oyuncu.sendMessage(ChatColor.BOLD + "" + ChatColor.DARK_GREEN  + "Sunucumuza Hoşgeldin Reis!");
    }
}



