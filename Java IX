package learnContinue9;

public class ElectricCar extends Car {
    private String model = "VMS-98HAS7Y";
    private String battery = "X12M Flash";
    private String color;

    // Default
    public ElectricCar() {
        this.color = "Gray";
    }

    // Setter
    public void setColor(String color) {
        this.color = color;
    }

    // Getter
    public String getColor() {
        return this.color;
    } public String getModel() {
        return this.model;
    } public String getBattery() {
        return this.battery;
    }
}


