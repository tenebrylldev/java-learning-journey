package learnContinue9;

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        System.out.println("--- Otopark Sistemine Hoş Geldiniz ---");

        GasolineCar bmw = new GasolineCar();
        ElectricCar tesla = new ElectricCar();

        System.out.print("Aracınız benzinli mi yoksa elektrikli mi olsun?: ");
        Scanner scanner = new Scanner(System.in);
        String choice = scanner.next().toLowerCase();

        switch (choice) {
            case "benzinli" -> choice = "BMW";
            case "elektrikli" -> choice = "Tesla";
            default -> System.out.println("Geçersiz Seçim.");
        }

        if (choice.equals("BMW")) {
            System.out.printf("Seçiminiz Benzinli %s olarak ayarlandı.%n", choice);
            System.out.printf("%s'niz hangi renk olmalı?: ", choice);

            bmw.setColor(scanner.next());
            System.out.printf("%nAracınız başarıyla %s rengine bürünmüştür!%n", bmw.getColor());

        } else if (choice.equals("Tesla")) {
            System.out.printf("Seçiminiz Elektrikli %s olarak ayarlandı.%n", choice);
            System.out.printf("%s'nız hangi renk olmalı?: ", choice);

            tesla.setColor(scanner.next());
            System.out.printf("%nAracınız başarıyla %s rengine bürünmüştür!%n", tesla.getColor());

        }
    }
}


