package moneySystem;

public class Main {
    public static void main(String[] args) {
        MoneyManager moneyManager = new MoneyManager();

        System.out.printf("Player's name: %s%n", moneyManager.getPlayerName());
        if (moneyManager.getPlayerBudget() % 1 == 0) {
            System.out.printf("Player's budget: %.0f%n", moneyManager.getPlayerBudget());
        } else {
            System.out.printf("Player's budget: %.1f%n", moneyManager.getPlayerBudget());
        }
    }
}

