package learnContinue10;

public class Sayac implements Runnable {

    @Override
    public void run() {
        for (int i = 1; i <= 10; i++) {
            try {
                System.out.println(i);

                if (i == 10) {
                    Thread.sleep(1000);
                    System.out.println("Disco!");
                } else
                    Thread.sleep(1000);

            } catch (InterruptedException interruptedException) {
                interruptedException.printStackTrace();
            }
        }
    }

}
